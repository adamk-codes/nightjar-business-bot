# Copy this file to .env and fill in your key. Never commit .env.
GEMINI_API_KEY=your-gemini-api-key

# Optional: override the models
# GEMINI_MODEL=gemini-3.5-flash
# GEMINI_ROUTER_MODEL=gemini-3.5-flash-lite
# GEMINI_REFLECTION_MODEL=gemini-3.1-flash-lite

# Optional: real push notifications to your phone via https://pushover.net
# PUSHOVER_USER=
# PUSHOVER_TOKEN=
